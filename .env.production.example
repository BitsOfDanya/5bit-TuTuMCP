# Public endpoint. DNS for this hostname must point to the deployment server.
# Use http://localhost only for a local production-like run.
APP_DOMAIN=travel.example.com
PUBLIC_ORIGIN=https://travel.example.com
ACME_EMAIL=ops@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Image coordinates. IMAGE_TAG should be immutable in production (for example sha-a1b2c3d4e5f6).
IMAGE_REGISTRY=ghcr.io
IMAGE_REPOSITORY=bitsofdanya/5bit-tutumcp
IMAGE_TAG=latest

# Application secrets. Generate both application secrets with: openssl rand -hex 32
OPENAI_API_KEY=
AUTH_SECRET_KEY=
AI_SERVICE_TOKEN=

# AI runtime.
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
DOCUMENT_EXTRACTION_MODEL=gpt-5.6-luna
AGENT_SYSTEM_PROMPT=Be concise, friendly, and accurate.

# Service limits and upstreams.
MAX_DOCUMENT_SIZE_BYTES=10485760
AI_SERVICE_TIMEOUT_SECONDS=90
CONSTRAINT_NEGOTIATOR_TIMEOUT_SECONDS=45
TRIP_RESCUE_TIMEOUT_SECONDS=120
SMART_TRIP_TRACKER_TIMEOUT_SECONDS=60
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
NEGOTIATOR_RATE_LIMIT_PER_MINUTE=60
MCP_TOOLS_CACHE_TTL_SECONDS=300
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_READ_TIMEOUT_SECONDS=90
MCP_WRITE_TIMEOUT_SECONDS=30
MCP_POOL_TIMEOUT_SECONDS=10
MCP_OPERATION_TIMEOUT_SECONDS=120
MCP_MAX_ATTEMPTS=3
MCP_RETRY_BASE_DELAY_SECONDS=0.5
MCP_RETRY_MAX_DELAY_SECONDS=4
LOG_LEVEL=INFO

# Authentication. AUTH_DEBUG must stay false in production.
AUTH_DEBUG=false
AUTH_COOKIE_NAME=tutumcp_session
AUTH_CODE_TTL_SECONDS=300
AUTH_SESSION_TTL_SECONDS=604800
