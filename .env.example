# Shared local-development settings. Copy this file to .env and fill in the key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none

# Backend -> ai-service authentication. Leave blank only for local development.
AI_SERVICE_TOKEN=

AI_SERVICE_URL=http://127.0.0.1:8020
AI_SERVICE_TIMEOUT_SECONDS=240
CONSTRAINT_NEGOTIATOR_URL=http://127.0.0.1:8010
CONSTRAINT_NEGOTIATOR_TIMEOUT_SECONDS=150
TUTU_MCP_URL=https://mcp.tutu.ru/mcp
SMART_TRIP_TRACKER_URL=http://127.0.0.1:8001
SMART_TRIP_TRACKER_TIMEOUT_SECONDS=60
TRIP_RESCUE_URL=http://127.0.0.1:8030
TRIP_RESCUE_TIMEOUT_SECONDS=120

AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
AUTH_DEBUG=true
