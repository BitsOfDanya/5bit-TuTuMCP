OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

AGENT_SYSTEM_PROMPT=You are a helpful assistant. Be concise and accurate.

TUTU_MCP_URL=https://mcp.tutu.ru/mcp

APP_HOST=0.0.0.0
APP_PORT=8010
APP_DEBUG=false

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=INFO

NEGOTIATOR_RATE_LIMIT_PER_MINUTE=60

MCP_TOOLS_CACHE_TTL_SECONDS=300

# Logging
LOG_LEVEL=INFO

# Rate limiting
NEGOTIATOR_RATE_LIMIT_PER_MINUTE=60

# MCP discovery cache
MCP_TOOLS_CACHE_TTL_SECONDS=300

# Tutu MCP networking
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_READ_TIMEOUT_SECONDS=90
MCP_WRITE_TIMEOUT_SECONDS=30
MCP_POOL_TIMEOUT_SECONDS=10

# Whole logical MCP operation,
# including retries and backoff
MCP_OPERATION_TIMEOUT_SECONDS=120

# Retries only for transient transport failures
MCP_MAX_ATTEMPTS=3
MCP_RETRY_BASE_DELAY_SECONDS=0.5
MCP_RETRY_MAX_DELAY_SECONDS=4

# Preference Learning persistence
PREFERENCE_STORE_PATH=./data/preferences.json

# Preference Learning persistence.
# Local default:
PREFERENCE_STORE_PATH=./data/preferences.json